# CULMERA API (Vercel serverless + Supabase). Copy to .env for local work. Never commit real values.
# PRODUCTION = Vercel "Production" environment. Preview/development deployments use the relaxed testing defaults.

# --- Required everywhere ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Use the "secret" key (sb_secret_...) or the legacy service_role key. NEVER put it in the front end.
SUPABASE_SERVICE_KEY=your-secret-key
# Comma-separated site origins that may call the API: scheme + host only, no path, no trailing slash, NO wildcard (* is ignored).
# Example: https://www.your-domain.com,https://your-domain.com
ALLOWED_ORIGIN=https://culmera-solutions.com,https://www.culmera-solutions.com

# --- Spam protection: Cloudflare Turnstile ---
# PRODUCTION: required. If it is missing the API refuses every submission with 503 (and logs turnstile_not_configured)
# instead of running unprotected. Set TURNSTILE_REQUIRED=0 only if you knowingly want an unprotected form.
# Development: optional; set TURNSTILE_REQUIRED=1 to test the production behaviour. Also set turnstileSiteKey in the front end's js/config.js.
TURNSTILE_SECRET=
TURNSTILE_REQUIRED=

# --- Rate limiting (production should use this) ---
# Distributed limiter via Upstash Redis REST (free tier is enough). Without it the API falls back to a per-instance
# in-memory counter, which is only best-effort on serverless and logs rate_limit_fallback_in_memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional secret that keys the hashed IP bucket names. Defaults to the Supabase key.
RATE_LIMIT_SALT=

# --- Email (Resend, https://resend.com): Phase 5 notifications and the public form ---
RESEND_API_KEY=
# The Founder's inbox. Gets EVERY notification (new client, brief submitted, client replied, call requested / moved / cancelled, invitation sent).
# Since Phase 2 the Founder is the ONLY one told about these events (see NOTIFY_STAFF below).
# Several addresses may be separated by commas. If empty, the Founder account's own email is used.
NOTIFY_EMAIL_TO=
# PRODUCTION: must be an address on a domain you verified in Resend, e.g. CULMERA <info@culmera-solutions.com>.
# In production the Resend test sender (onboarding@resend.dev) is refused. In development an empty value uses it for testing.
EMAIL_FROM=
# The thank-you email to the client right after a brief (public form and signed-in client) is ON by default.
# Set to 0 to turn it off. Needs a verified EMAIL_FROM. It never blocks saving the brief.
CONFIRM_CLIENT=
# Where a client's answer to our emails goes (the Reply-To of the thank-you and of the Founder's replies).
# Default: the first address in NOTIFY_EMAIL_TO. Must be a plain address (name@domain).
REPLY_TO=
# Partner and Director no longer get event emails (new client, brief, call, reply). Set to 1 to bring the old behaviour back:
# the owning partner and that partner's Director are told too. The invitation email to a Director is not affected.
NOTIFY_STAFF=
# Optional: the time zone used for times inside notification emails (default: MEETING_TZ, then Africa/Cairo).
OWNER_TZ=
# Optional: the site address used in email links and invitations (default: https://culmera-solutions.com).
SITE_URL=

# --- Optional chat notification (https only). Discord webhook, or Telegram: https://api.telegram.org/botTOKEN/sendMessage?chat_id=CHATID ---
NOTIFY_WEBHOOK_URL=

# --- Time zone used for times inside the Founder's notification emails ---
# (Phase 2: the brief has no meeting step any more, so MEETING_DAYS / MEETING_FROM / MEETING_TO are gone. You can delete them from Vercel.)
MEETING_TZ=Africa/Cairo
